# =========================
# Application Core
# =========================
APP_NAME=Bedrock
API_SERVER_URL=http://localhost:8000
CLIENT_URL=http://localhost:8080
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-me

# =========================
# Runtime / Process
# =========================
GUNICORN_BIND=localhost:8000
GUNICORN_PID_FILE_PATH=/var/run/gunicorn/gunicorn.pid

# =========================
# Network / CORS
# =========================
ALLOWED_HOSTS=localhost,api.workos.com
CORS_ORIGIN_ALLOW_ALL=False
CORS_ORIGIN_WHITELIST=https://localhost:8000,https://api.workos.com

# =========================
# Logging
# =========================
LOGGER_FILE_PATH=/var/log/bedrock/application.log
LOGGER_HANDLERS=console,file
LOGGER_LEVEL=WARNING

# =========================
# Django Admin / API Docs
# =========================
DJANGO_ADMIN_SITE_ENABLED=False
DJANGO_ADMIN_URL=division-2/devoffice/
API_DOC_LOGIN_URL=/developers/auth/
INTERNAL_API_DOC_ENABLED=False
INTERNAL_API_DOC_URL=division-2/develoffice/docs/api/
INTERNAL_API_DOWNLOAD_URL=division-2/develoffice/openapi/
EXTERNAL_API_DOC_ENABLED=False
EXTERNAL_API_DOC_URL=public/docs/api/
EXTERNAL_API_DOWNLOAD_URL=public/openapi/

# =========================
# Database
# =========================
POSTGRES_HOST=localhost
POSTGRES_DB=postgres_db
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=replace-me

# =========================
# Paths / Static / Media
# =========================
DJANGO_TEMPLATE_DIR=bedrock_frontend/dist/
DJANGO_STATIC_DIR=bedrock_frontend/dist/static/
# For local development with celery docker containers, set the following
# to /app/templates.
EMAIL_TEMPLATE_DIR=/app/templates/emails
EMAIL_ASSET_BASE_URL=http://localhost:8000/static/email
# For local development with celery docker containers, set the following
# to something like /app/....
GOOGLE_SERVICE_ACCOUNT_PATH=
MEDIA_ROOT=media
MEDIA_URL='/media/'

# =========================
# Celery / Jobs
# =========================
CELERY_BROKER_URL=redis://localhost:6379/0
# For production, CELERY_TASK_IGNORE_RESULT and
# CELERY_TASK_STORE_ERRORS_EVEN_IF_IGNORED should be False.
# If CELERY_TASK_IGNORE_RESULT is False, CELERY_RESULT_BACKEND matters.
# If CELERY_TASK_IGNORE_RESULT is True, CELERY_RESULT_BACKEND won't be used.
CELERY_TASK_IGNORE_RESULT=True
CELERY_TASK_STORE_ERRORS_EVEN_IF_IGNORED=True
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =========================
# Auth / JWT
# =========================
ACCESS_TOKEN_LIFETIME_MINS=30
REFRESH_TOKEN_LIFETIME_DAYS=30
UPDATE_LAST_LOGIN=True

# =========================
# Email / Verification
# =========================
EMAIL_VERIFICATION_CODE_LENGTH=32
EMAIL_VERIFICATION_CODE_LIFETIME_HOURS=24
EMAIL_DRIVER=smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=replace-me@example.com

# =========================
# Tenant / Workspace
# =========================
TENANT_DOMAIN_LENGTH=32
TENANT_ACCOUNT_ID_LENGTH=16
TENANT_INVITATION_CODE_LENGTH=32
TENANT_INVITATION_CODE_LIFETIME_HOURS=72
TENANT_INVITATION_CODE_REQUEST_MAX_SIZE=200

# =========================
# Login / Password / Throttling
# =========================
FAILED_LOGIN_ATTEMPT_MAX_COUNT=5
LOGIN_LOCK_PERIOD_MINS=10
PASSWORD_RESET_CODE_LENGTH=32
PASSWORD_RESET_CODE_LIFETIME_HOURS=24
DRF_THROTTLE_RATES_ANONYMOUS='1000/h'
DRF_THROTTLE_RATES_USER='6000/h'

# =========================
# AI
# =========================
OPENAI_API_KEY=replace-me

# =========================
# SSO / WorkOS
# =========================
SSO_ENABLED=True
SSO_WORKOS_API_KEY=replace-me
SSO_WORKOS_CLIENT_ID=replace-me
SSO_REDIRECT_PATH=auth/sso/callback

# =========================
# Test / SSO Fixtures
# =========================
TEST_SSO_DOMAIN=example.com
TEST_WORKOS_CONNECTION_ID=conn_example
TEST_SSO_USER_EMAIL=test-sso-user@example.com
TEST_SSO_USER_FIRST_NAME=Test
TEST_SSO_USER_LAST_NAME=User